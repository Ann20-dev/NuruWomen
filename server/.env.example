# The port this server listens on.
PORT=3000

# Base URL of the private Python AI service.
# Local development: the FastAPI app running on your machine.
# Production: the Render internal URL of the private service.
AI_SERVICE_URL=http://127.0.0.1:8000

# Shared secret for the AI service. Must match WHC_API_KEY there exactly.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value.
WHC_API_KEY=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS

# Comma-separated browser origins permitted to call the API.
# Leave empty to skip the check. Production sets the deployed site origin.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080