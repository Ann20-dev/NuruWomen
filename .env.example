# Server-only values. Never prefix WHC_API_KEY with VITE_.
WHC_API_KEY=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
PORT=10000
NODE_ENV=production
WHC_DEMO_MODE=true
AI_SERVICE_URL=http://127.0.0.1:8000
# Optional comma-separated browser origins. Same-origin is accepted by default.
ALLOWED_ORIGINS=
