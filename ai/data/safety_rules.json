        "\\bdamu nyingi\\b"
      ]
    },
    {
      "id": "fainting",
      "patterns": [
        "\\b(?:fainted|fainting|feel faint|feeling faint|unconscious)\\b",
        "\\b(?:kuzimia|nimezimia|ninazimia|nazimia|napoteza fahamu)\\b"
      ]
    },
    {
      "id": "severe_pain",
      "patterns": [
        "\\bsevere (?:abdominal |pelvic |chest |period |menstrual )?pain\\b",
        "\\bmaumivu makali\\b"
      ]
    },
    {
      "id": "breathing",
      "patterns": [
        "\\b(?:cannot|can.t|unable to) breathe\\b",
        "\\b(?:difficulty breathing|shortness of breath)\\b",
        "\\b(?:siwezi kupumua|shida ya kupumua)\\b"
      ]
    },
    {
      "id": "self_harm",
      "patterns": [
        "\\b(?:kill myself|end my life|hurt myself|suicid\\w*)\\b",
