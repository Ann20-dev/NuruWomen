      "id": "immediate_threat",
      "patterns": [
        "\\b(?:in immediate danger|being attacked|threatening to kill)\\b",
        "\\b(?:niko hatarini|ananishambulia)\\b"
      ]
    },
    {
      "id": "violence_assault",
      "patterns": [
        "\\b(?:rape|raped|sexual assault|forced me|forced himself|beat me|beats me)\\b",
        "\\b(?:ubakaji|nimebakwa|amenibaka|ananipiga)\\b"
      ]
    },
    {
      "id": "pregnancy_concern",
      "patterns": [
        "\\b(?:pregnant|pregnancy|mjamzito|ujauzito|mimba)\\b"
      ],
      "all_patterns": [
        "\\b(?:bleeding|bleed|damu|severe headache|blurred vision|reduced movement|baby stopped moving|maumivu makali)\\b"
      ]
    },
    {
      "id": "postpartum_concern",
      "patterns": [
        "\\b(?:postpartum|after birth|after giving birth|since delivery|baada ya kujifungua)\\b"
      ],
      "all_patterns": [
        "\\b(?:bleeding|bleed|fever|chest pain|difficulty breathing|damu|homa|kupumua)\\b"
